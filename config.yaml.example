# acme-gateway configuration example
# Copy to config.yaml and edit before running.
# Sensitive values support ${ENV_VAR} interpolation.

server:
  listen: ":443"
  base_url: "https://acme-gateway.internal"
  # Uncomment the line below to disable TLS termination at the gateway.
  # Use this when a Kubernetes Ingress controller, cloud load balancer, or
  # service mesh terminates HTTPS before requests reach this process.
  # base_url must still begin with https:// — ACME clients connect via https://
  # through the external terminator, and that URL is signed into JWS requests.
  # When tls: false, bootstrap must also be disabled and cert_path/key_path
  # are not required.
  # tls: false

state:
  db_path: "/var/lib/acme-gateway/state.db"

# Gateway TLS certificate — obtained automatically via dns-01 on first start.
# Set enabled: true to use the built-in dns-01 bootstrap and 30-day renewal loop.
# Set enabled: false to supply an externally-managed certificate (cert-manager,
# Ansible cron, etc.). Both modes require cert_path and key_path.
#
# NOTE (enabled: false): the gateway loads the keypair once at startup and does
# not reload it automatically. Restart the gateway after an external renewal to
# serve the new certificate.
bootstrap:
  enabled: true
  upstream: letsencrypt           # must match a key in the upstreams block
  domain: "acme-gateway.internal"
  contact_email: "certadmin@example.com"
  challenge: dns-01
  cert_path: "/etc/acme-gateway/server.crt"
  key_path:  "/etc/acme-gateway/server.key"
  renew_before_days: 30
  dns_hook:
    deploy_script:  "/etc/acme-gateway/hooks.d/deploy-dns.sh"
    cleanup_script: "/etc/acme-gateway/hooks.d/cleanup-dns.sh"
    # Optional authoritative-propagation check (background; non-fatal on timeout).
    # See the upstream dns_hook below and docs/decisions/0008 for details. Lower
    # quorum_percent (e.g. 80) for CAs whose anycast nameservers converge unevenly.
    propagation:
      enabled: true
      timeout_seconds: 300
      poll_seconds: 2
      min_consecutive_successes: 3
      quorum_percent: 100
    # Optional CNAME delegation support for dns-01. When enabled, if
    # _acme-challenge.<domain> is a CNAME, hooks write/check at the delegated
    # target name. allowed_zone_suffixes is optional; if omitted/empty, any
    # delegated zone is accepted.
    delegation:
      enabled: false
      mode: strict # strict|permissive
      # allowed_zone_suffixes:
      #   - "delegated.example.net"

upstreams:
  letsencrypt:
    directory_url: "https://acme-v02.api.letsencrypt.org/directory"
    contact_email: "certadmin@example.com"
    # account_count spreads new orders across N independent ACME accounts to
    # stay within Let's Encrypt's 50-orders-per-account-per-3h rate limit.
    # For a fleet of 50 servers all renewing at the same time, 2 accounts
    # provides comfortable headroom. Not compatible with EAB upstreams.
    account_count: 3
    # REQUIRED for dns-01 challenges: The gateway's upstream account key differs
    # from the client's gateway account key. Clients compute dns-01 TXT using their
    # gateway key, but the upstream CA validates using the gateway's upstream key.
    # The dns_hook lets the gateway publish the correct upstream-derived TXT so that
    # the upstream CA can validate it. Without this, dns-01 fails with "Correct value
    # not found" even if a TXT record exists (it's just the wrong one).
    #
    # LIMITATION (intentional): dns_hook is configured per-upstream, and each
    # upstream executes one deploy/cleanup implementation. acme-gateway does not
    # infer authoritative DNS service from SOA/NS and does not select provider
    # per-domain. If one upstream handles domains across multiple providers,
    # implement that routing outside the gateway in the configured hook command.
    dns_hook:
      deploy_script:  "/etc/acme-gateway/hooks.d/deploy-dns.sh"
      cleanup_script: "/etc/acme-gateway/hooks.d/cleanup-dns.sh"
      # Authoritative-propagation check. Answer-challenge returns immediately;
      # this wait runs in the background before the gateway triggers the upstream
      # (see docs/decisions/0008). The timeout is non-fatal — the TXT record is
      # already published, so on timeout the gateway triggers the upstream anyway;
      # only a deploy-hook *error* fails the challenge.
      propagation:
        enabled: true
        timeout_seconds: 300
        poll_seconds: 2
        min_consecutive_successes: 3
        # quorum_percent: percentage of authoritative nameservers that must serve
        # the TXT before triggering. Default 100. For CAs whose anycast NS converge
        # unevenly (one node may lag indefinitely), set below 100 — e.g. 80 for a
        # 4-of-5 set — so the background worker triggers promptly instead of waiting
        # out the full timeout_seconds.
        quorum_percent: 100
      delegation:
        enabled: false
        mode: strict # strict|permissive
        # allowed_zone_suffixes:
        #   - "delegated.example.net"
    # No EAB required for Let's Encrypt.
    # ca_cert_path is not needed for public CAs with well-known roots.

  # For LE staging tests, replace with:
  # letsencrypt:
  #   directory_url: "https://acme-staging-v02.api.letsencrypt.org/directory"
  #   contact_email: "certadmin@example.com"

  private-ca-rsa:
    directory_url: "https://acme.your-private-ca.example/directory"
    contact_email: "certadmin@example.com"
    # ca_cert_path: "/etc/acme-gateway/private-ca.pem"  # PEM CA cert to trust for TLS to this upstream
    eab:
      key_id:   "${PRIVATE_CA_RSA_EAB_KID}"
      hmac_key: "${PRIVATE_CA_RSA_EAB_HMAC}"

  private-ca-ecdsa:
    directory_url: "https://acme.your-private-ca.example/directory"
    contact_email: "certadmin@example.com"
    # ca_cert_path: "/etc/acme-gateway/private-ca.pem"
    eab:
      key_id:   "${PRIVATE_CA_ECDSA_EAB_KID}"
      hmac_key: "${PRIVATE_CA_ECDSA_EAB_HMAC}"

# Profile names here are the gateway's own operator-defined vocabulary.
# They are advertised in /directory and matched against newOrder requests.
# They have NO required relationship to any upstream CA's profile namespace.
profiles:
  tlsserver:  "Server certificate via Let's Encrypt"
  shortlived: "Short-lived (6-day) server certificate via Let's Encrypt"
  tlsclient:  "Client certificate via private CA (RSA or ECDSA based on key type)"

routing:
  rules:
    # Override: map gateway profile → LE's own profile name explicitly.
    - match:
        profile: "shortlived"
      upstream: letsencrypt
      upstream_profile: "shortlived"

    - match:
        profile: "tlsserver"
      upstream: letsencrypt
      upstream_profile: "tlsserver"

    # Passthrough: forward the gateway profile name to the upstream unchanged.
    # Use this when the upstream CA uses the same profile vocabulary as the gateway,
    # so no translation is needed.
    # - match:
    #     profile: "custom-profile"
    #   upstream: some-upstream
    #   upstream_profile: "$passthrough"

    # Strip (default): private CA routing is via EAB credentials, no upstream profile needed.
    - match:
        profile: "tlsclient"
        key_type: "RSA"
      upstream: private-ca-rsa
      # upstream_profile omitted → strip (no profile field sent upstream)

    - match:
        profile: "tlsclient"
        key_type: "ECDSA"
      upstream: private-ca-ecdsa

    # Domain-suffix fallbacks (for clients not using --preferred-profile).
    - match:
        domain_suffix: ".internal"
      upstream: private-ca-rsa

    - match:
        key_type: "RSA"
      upstream: private-ca-rsa

    - match:
        key_type: "ECDSA"
      upstream: private-ca-ecdsa

  default_upstream: letsencrypt
