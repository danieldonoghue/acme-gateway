$TTL 60
@   IN  SOA ns1.pebble-test.local. admin.pebble-test.local. (
            2024010101  ; serial
            3600        ; refresh
            1800        ; retry
            604800      ; expire
            86400       ; minimum
            )
    IN  NS  ns1.pebble-test.local.

ns1 IN  A   127.0.0.1

; ACME test domains
*.pebble-test.local.  IN  A   127.0.0.1
