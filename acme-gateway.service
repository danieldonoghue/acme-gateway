[Unit]
Description=ACME Gateway — ACMEv2 routing proxy
Documentation=https://github.com/danieldonoghue/acme-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=acme-gateway
Group=acme-gateway

ExecStart=/usr/local/bin/acme-gateway -config /etc/acme-gateway/config.yaml
Restart=on-failure
RestartSec=5s

# Environment variables for EAB credentials (override or use a EnvironmentFile).
# EnvironmentFile=/etc/acme-gateway/secrets.env

# Security hardening.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/acme-gateway /etc/acme-gateway

# Allow binding to port 443.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Resource limits.
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
